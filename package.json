{
  "name": "lent-borrowed-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet place for the things you lend and borrow. Keep a photo, the person and the agreed return date together, then mark the handoff complete.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/build.test.mjs test/core.test.mjs scripts/static-test-server.test.mjs",
    "check": "node scripts/check.mjs && prettier --check .",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
